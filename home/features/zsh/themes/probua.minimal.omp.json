{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#e4bad9",
    "template": "❯ "
  },
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#e4bad9",
          "style": "plain",
          "template": "{{ .UserName }}@{{ .HostName }} ",
          "type": "session"
        },
        {
          "foreground": "#b8c3ff",
          "style": "plain",
          "options": {
            "style": "full"
          },
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "options": {
            "branch_icon": "",
            "fetch_status": true
          },
          "style": "plain",
          "template": "git:{{ if or (.Working.Changed) (.Staging.Changed) (gt .StashCount 0) }}<#e4bad9>{{ .HEAD }}</>{{ else }}{{ .HEAD }}{{ end }}{{ if .Staging.Changed }} <#c3c5dd>{{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }} <#ffb4ab>{{ .Working.String }}</>{{ end }}",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "type": "rprompt",
      "overflow": "hidden",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#b8c3ff",
          "background": "transparent",
          "template": "{{ .FormattedMs }}",
          "options": {
            "threshold": 500,
            "style": "austin",
            "always_enabled": false
          }
        }
      ]
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#e4bad9",
          "foreground_templates": ["{{ if gt .Code 0 }}#ffb4ab{{ end }}"],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "❯ ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
