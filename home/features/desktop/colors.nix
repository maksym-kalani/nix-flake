# Shared color definitions for the desktop environment
# All desktop components (hyprland, waybar, rofi, wlogout) use these colors
{
  # Base colors
  background = "#121318";
  backgroundRgba = "rgba(121318ff)";
  backgroundTransparent = "rgba(18, 19, 24, 0.3)";
  backgroundDark = "#07164b";

  # Surface colors
  surface = "#121318";
  surfaceRgba = "rgba(44, 47, 66, 0.7)";

  # Text/foreground colors
  foreground = "#e3e1e9";
  onSurface = "#e3e1e9";
  onSurfaceRgba = "rgba(e3e1e9ff)";

  # Accent colors
  primary = "#b8c3ff";
  primaryRgba = "rgba(b8c3ffff)";
  onPrimary = "#202c61";

  # Status colors
  error = "#ffb4ab";
  errorRgba = "rgba(ffb4abff)";

  # Shadow
  shadow = "#000000";
}
